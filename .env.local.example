# Base URL of the FastAPI transpiler backend hosted on Render.
# The frontend POSTs to `${NEXT_PUBLIC_TRANSPILER_API_URL}/transpile`
# with JSON body: { "qasm": string, "version": "2.0" | "3.0" }
# and expects a JSON response containing a `braket_ir` (or `ir`) field.
# Also used by /docs/api-reference: when set, the interactive API reference
# fetches the live spec from `${NEXT_PUBLIC_TRANSPILER_API_URL}/openapi.json`
# instead of the committed static snapshot at public/openapi/quantumflow-api.json.
NEXT_PUBLIC_TRANSPILER_API_URL=https://your-app.onrender.com

# Google Search Console HTML-tag verification code.
# Search Console -> Settings -> Ownership verification -> HTML tag method -> copy the `content` value.
GOOGLE_SITE_VERIFICATION=
